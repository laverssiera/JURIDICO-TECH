# Core app settings
APP_NAME=JURIDICOTECH
APP_VERSION=6.0.0
DATABASE_URL=sqlite+aiosqlite:///./legal.db
REDIS_URL=redis://localhost:6379/0
NATS_URL=nats://localhost:4222

# JWT (change in production)
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_256_BIT_SECRET
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Federation authority
MONOLITH_NAME=juridicotech

# Federation shared infra
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=liceu
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Federation backend selection
# Options:
# - FEDERATION_MEMORY_BACKEND: auto|memory|redis
# - FEDERATION_GRAPH_BACKEND: auto|memory|neo4j
# - FEDERATION_OBSERVABILITY_BACKEND: auto|memory|otel
FEDERATION_MEMORY_BACKEND=auto
FEDERATION_GRAPH_BACKEND=auto
FEDERATION_OBSERVABILITY_BACKEND=auto

# Federation domain toggles
SPACE_LAW_RUNTIME=true
PLANETARY_COMPLIANCE=true
INTERPLANETARY_ARBITRATION=true
